# ─── Local Development ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Neon / PostgreSQL connection string (with ?sslmode=require for Neon)
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# JWT — use a strong random secret (min 32 chars) in production
JWT_SECRET=your_jwt_signing_secret_here_at_least_32_chars
JWT_EXPIRES_IN=1d

# ─── Mentor Seed (used by prisma/seed.ts) ───────────────────────────
INITIAL_MENTOR_EMAIL=mentor@example.com
INITIAL_MENTOR_PASSWORD=your_mentor_password_here
INITIAL_MENTOR_NAME=Senior Mentor

# ─── Production Notes ────────────────────────────────────────────────
# NODE_ENV=production
# PORT is set automatically by Render (10000) — do NOT hardcode in prod
# CLIENT_URL=https://your-app.vercel.app   ← set in Render dashboard
# DATABASE_URL — same Neon URL with sslmode=require
# JWT_SECRET — use Render's "Generate" feature or a secure random value
